# Normalise line endings: the tree is developed on Linux, scripts run under bash
# on the GitHub runner, and a CRLF shell script fails with an opaque error.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.cu   text eol=lf
*.h    text eol=lf
*.cc   text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.pkl  binary
*.onnx binary
*.plan binary
*.so   binary
